# Copy this file to .env.local and fill in the values. Never commit .env.local.

# PayPal sandbox keys: developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox buyer account email (a personal sandbox account) that receives test invoices
PAYPAL_SANDBOX_BUYER_EMAIL=

# Payments database (Neon Postgres; on Vercel, add Neon from the Marketplace and it sets this).
# Optional: without it the app keeps payment records on the owner's device only. Create the
# tables with: npm run db:migrate
DATABASE_URL=
# The PayPal webhook's id, from developer.paypal.com → your app → Webhooks, after adding
# <site>/api/paypal/webhook for the INVOICING.INVOICE.* events. Needs DATABASE_URL.
PAYPAL_WEBHOOK_ID=
# Optional. A database of its own for lib/payment-db.test.ts, which writes and removes test
# rows (e.g. a separate Neon branch). Without it those tests are skipped.
TEST_DATABASE_URL=

# Optional. Leave empty for the defaults: https://api-m.sandbox.paypal.com and MYR
PAYPAL_API_BASE=
# MYR works only between two Malaysia-country accounts. Both sandbox accounts must
# be created with country Malaysia. If they are not, set PAYPAL_CURRENCY=USD.
PAYPAL_CURRENCY=

# AG Studio (Insights dashboard) licence key from AG Grid. Optional: without it Studio runs
# as a trial with a watermark. It ends up in the browser bundle, which is how AG keys work.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# Nudge, the reminder assistant: a Vercel AI Gateway key (Vercel dashboard → AI Gateway →
# API keys). On Vercel the project's OIDC token works instead. Without either, Nudge says it
# isn't connected.
AI_GATEWAY_API_KEY=
# Optional. Any model ID from https://ai-gateway.vercel.sh/v1/models; defaults to anthropic/claude-haiku-5.5
AI_GATEWAY_MODEL=
# Optional vision-capable model for notebook scans; falls back to AI_GATEWAY_MODEL.
AI_GATEWAY_VISION_MODEL=

# Private Vercel Blob store used for notebook images.
BLOB_READ_WRITE_TOKEN=

# Protects Vercel's hourly reminder cron endpoint.
CRON_SECRET=

# Sign-in. AUTH_SECRET signs the sign-in cookies: 32+ random characters, e.g.
#   openssl rand -base64 48
# Without it every owner page sends people to sign-in and sign-in says it isn't set up.
AUTH_SECRET=
# Emails the sign-in codes. Gmail is used first: the address plus a Google app password
# (myaccount.google.com/apppasswords, needs 2-Step Verification). Keep the password in
# Vercel only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or Resend, set by the Resend integration on Vercel. With neither, local dev prints the code
# in the terminal instead. RESEND_FROM is optional (needs a verified domain).
RESEND_API_KEY=
RESEND_FROM=
# Who may sign in as the shop owner (comma-separated). Anyone else gets the same screens but
# can never sign in. Required on Vercel: with no list, nobody can sign in in production.
# Put * in the list to let any email sign in (temporary; remove it to lock sign-in again).
OWNER_EMAILS=
# Optional private codes for owners while email isn't set up: "email:CODE,email:CODE",
# 12 letters or digits each, generated randomly. Used instead of emailing a code. Keep it
# secret (Vercel only).
OWNER_CODES=
# Optional demo login for judges: this email signs in with this 6-character code (letters and
# digits, e.g. DEMO42), no email sent. It counts as an owner. Turn it off after judging.
DEMO_EMAIL=
DEMO_CODE=
# Optional. The site's public address for PayPal's login return URL; defaults to the request's.
SITE_URL=
